# Copy to `terraform/secrets.auto.tfvars` and fill in real values.
# That filename is gitignored; this .example file is what gets committed.
# Terraform loads any `*.auto.tfvars` automatically -- no -var-file flag needed.

# GitHub PAT with the `read:packages` scope ONLY (nothing else is required to
# pull images). Create at:
#   https://github.com/settings/tokens  ->  classic token, scope: read:packages
# Then:  gh auth token  will NOT work here -- that token is short-lived and
# tied to the CLI session; mint a dedicated PAT for the cluster.
github_token = "ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional overrides (defaults in variables.tf are usually right):
# github_username          = "arestrepo99"
# ghcr_namespaces          = ["cup"]
# gitops_repo_ssh_key_path = "~/.ssh/github_personal_server"
