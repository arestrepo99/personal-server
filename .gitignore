# Terraform
terraform/.terraform/
terraform/*.tfstate
terraform/*.tfstate.*
terraform/crash.log
terraform/crash.*.log
terraform/*.tfvars.json
# Plan files can contain sensitive resource values in plaintext (e.g. the
# SSH private key in kubernetes_secret.gitops_repo_creds) -- never commit.
terraform/tfplan
terraform/*.tfplan
# Real secret values (GHCR PAT, etc.) live in *.auto.tfvars, which Terraform
# loads automatically and git never sees. The committed
# terraform/secrets.auto.tfvars.example documents what goes in it.
terraform/*.auto.tfvars
!terraform/*.auto.tfvars.example
# terraform.tfvars is NOT secret (just a repo URL) -- intentionally tracked.
# .tf files are tracked directly (no .tf.txt source-of-truth split).

# Claude Code local tool state -- not part of the infra repo
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Never commit raw secrets. SealedSecrets (encrypted) are fine and expected
# in gitops/ -- this rule is a backstop against accidentally adding a
# plain Secret manifest or a .env file with real credentials.
*.env
**/secrets/*.yaml
!**/secrets/*.sealed.yaml
gitops/netbird/config.yaml
